    "                        break\n",
    "            \n",
    "            print(f\"Extracted metrics for {len(metrics_dict)} visits\")\n",
    "            \n",
    "        except Exception as e:\n",
    "            print(f\"Error processing data: {e}\")\n",
    "            # Try fetching individually\n",
    "            print(\"Trying individual fetch...\")\n",
    "            for i, ref in enumerate(dataset_refs[:5]):\n",
