    "# Calculate skynoise from limiting magnitude\n",
    "# skysurvey expects 'skynoise' column (inverse variance in e-/pixel)\n",
    "\n",
    "def calculate_skynoise_from_maglim(maglim, zp=30.0, gain=1.0):\n",
    "    \"\"\"\n",
    "    Calculate skynoise (inverse variance) from 5-sigma limiting magnitude.\n",
    "    \n",
    "    Uses the formula from skysurvey.tools.utils.get_skynoise_from_maglimit:\n",
    "    skynoise = 1.0 / (gain * 10.0 ** ((zp - m5) / 2.5))\n",
    "    \n",
    "    Parameters\n",
    "    ----------\n",
    "    maglim : array-like\n",
    "        5-sigma limiting magnitude\n",
    "    zp : float\n",
    "        Zeropoint (default 30.0, skysurvey convention)\n",
    "    gain : float\n",
    "        Gain (default 1.0, skysurvey convention)\n",
    "    \n",
    "    Returns\n",
    "    -------\n",
    "    skynoise : array-like\n",
    "        Inverse variance in e-/pixel\n",
    "    \"\"\"\n",
    "    flux_5sigma = 10.0 ** ((zp - maglim) / 2.5)\n",
    "    skynoise = 1.0 / (gain * flux_5sigma)\n",
    "    return skynoise\n",
    "\n",
    "# Check what limiting magnitude columns we have\n",
    "maglim_columns = ['mean_maglim', 'fiveSigmaDepth', 'maglim', 'm5']\n",
    "available_maglim_col = None\n",
    "for col in maglim_columns:\n",
    "    if col in df_ddf.columns and not df_ddf[col].isna().all():\n",
    "        available_maglim_col = col\n",
    "        break\n",
    "\n",
    "if available_maglim_col:\n",
    "    print(f\"Using '{available_maglim_col}' for limiting magnitude\")\n",
    "    df_ddf['skynoise'] = calculate_skynoise_from_maglim(df_ddf[available_maglim_col].values)\n",
    "    print(f\"Calculated skynoise from {available_maglim_col}\")\n",
    "else:\n",
    "    print(\"WARNING: No limiting magnitude column found - cannot calculate skynoise\")\n",
    "    print(\"Available mag-related columns:\")\n",
    "    for col in df_ddf.columns:\n",
    "        if 'mag' in col.lower() or 'depth' in col.lower() or 'limit' in col.lower():\n",
    "            print(f\"  - {col}\")"
   ]
