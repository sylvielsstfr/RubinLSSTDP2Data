   "source": [
    "# Define DDF identification patterns\n",
    "DDF_PATTERNS = [\n",
    "    'DDF',\n",
    "    'COSMOS',\n",
    "    'ELAIS',\n",
    "    'XMM',\n",
    "    'ECDFS',\n",
    "    'EDFS',\n",
    "    'M49',\n",
    "]\n",
    "\n",
    "def is_ddf_visit(row):\n",
    "    \"\"\"Check if a visit is part of DDF.\"\"\"\n",
    "    target = str(row.get('target_name', '') or '')\n",
    "    science_program = str(row.get('science_program', '') or '')\n",
    "    \n",
    "    # Check target name\n",
    "    target_upper = target.upper()\n",
    "    for pattern in DDF_PATTERNS:\n",
    "        if pattern in target_upper:\n",
    "            return True\n",
    "    \n",
    "    # Check science program\n",
    "    science_program_upper = science_program.upper()\n",
    "    for pattern in DDF_PATTERNS:\n",
    "        if pattern in science_program_upper:\n",
    "            return True\n",
    "    \n",
    "    return False\n",
    "\n",
    "# Apply DDF filter\n",
    "df_visits['is_ddf'] = df_visits.apply(is_ddf_visit, axis=1)\n",
    "df_ddf = df_visits[df_visits['is_ddf']].copy()\n",
    "df_ddf.reset_index(drop=True, inplace=True)\n",
    "\n",
    "print(f\"Total visits: {len(df_visits)}\")\n",
    "print(f\"DDF visits: {len(df_ddf)}\")\n",
    "print(f\"Non-DDF visits: {len(df_visits) - len(df_ddf)}\")"
   ]
