   "source": [
    "def extract_metrics_from_visit_table(butler, dataset_type_name, where_clause, limit=1000):\n",
    "    \"\"\"\n",
    "    Extract metrics from consolidated visit table (cp_pipe_cpVisitTable).\n",
    "    \n",
    "    The cp_pipe_cpVisitTable contains per-visit consolidated metrics including:\n",
    "    - mean_seeing: mean seeing FWHM (arcseconds)\n",
    "    - mean_skyBg: mean sky background (mag/arcsec^2)\n",
    "    - mean_maglim: mean 5-sigma limiting magnitude\n",
    "    - fiveSigmaDepth: limiting depth\n",
    "    \n",
    "    Parameters\n",
    "    ----------\n",
    "    butler : Butler\n",
    "    dataset_type_name : str\n",
    "    where_clause : str\n",
    "    limit : int\n",
    "    \n",
    "    Returns\n",
    "    -------\n",
    "    metrics_dict : dict\n",
    "        Dictionary mapping visit IDs to their metrics\n",
    "    \"\"\"\n",
    "    metrics_dict = {}\n",
    "    \n",
    "    try:\n",
    "        # Query datasets\n",
    "        dataset_refs = list(registry.queryDatasets(\n",
    "            datasetType=dataset_type_name,\n",
    "            where=where_clause,\n",
    "            limit=limit\n",
    "        ))\n",
    "        \n",
    "        print(f\"Found {len(dataset_refs)} {dataset_type_name} datasets\")\n",
    "        \n",
    "        if not dataset_refs:\n",
    "            return metrics_dict\n",
    "        \n",
    "        # Fetch data\n",
    "        try:\n",
    "            visit_data = butler.get(dataset_type_name, dataIds=[ref.dataId for ref in dataset_refs])\n",
    "            print(f\"Successfully loaded {dataset_type_name}\")\n",
    "            \n",
    "            # Convert to Astropy Table if possible\n",
    "            if hasattr(visit_data, 'to_table'):\n",
    "                table = visit_data.to_table()\n",
    "            elif hasattr(visit_data, 'asAstropy'):\n",
    "                table = visit_data.asAstropy()\n",
    "            elif isinstance(visit_data, pd.DataFrame):\n",
    "                table = visit_data\n",
    "            else:\n",
    "                print(f\"Unknown format: {type(visit_data)}\")\n",
    "                # Try to access as list\n",
    "                if isinstance(visit_data, (list, np.ndarray)):\n",
    "                    table = visit_data[0]\n",
    "                else:\n",
    "                    return metrics_dict\n",
    "            \n",
    "            # Extract metrics\n",
    "            visit_id_col = 'id' if 'id' in table.colnames else ('visitId' if 'visitId' in table.colnames else None)\n",
    "            if visit_id_col is None:\n",
    "                print(f\"No ID column found in table columns: {table.colnames}\")\n",
    "                return metrics_dict\n",
    "            \n",
    "            for row in table:\n",
    "                vid = row[visit_id_col]\n",
    "                metrics_dict[vid] = {}\n",
    "                \n",
    "                # Extract each metric if available\n",
    "                for metric_name in ['mean_seeing', 'seeing', 'FWHMeff', 'fwhmEff', 'psfFwhm']:\n",
    "                    if metric_name in row.colnames:\n",
    "                        metrics_dict[vid]['mean_seeing'] = float(row[metric_name])\n",
    "                        break\n",
    "                \n",
    "                for metric_name in ['mean_skyBg', 'skyBg', 'skyBackground', 'sky_brightness']:\n",
