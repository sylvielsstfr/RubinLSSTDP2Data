    "---\n",
    "## 4. Extract Visits from Exposure Records"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Define WHERE clause for filtering\n",
    "WHERE_CLAUSE_INSTRUMENT = f\"instrument = '{INSTRUMENT}'\"\n",
    "WHERE_CLAUSE_DATE = f\"{WHERE_CLAUSE_INSTRUMENT} and day_obs >= {DATE_START}\"\n",
    "print(f\"WHERE clause: {WHERE_CLAUSE_DATE}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def extract_visits_from_exposure(registry, where_clause, limit=None):\n",
    "    \"\"\"\n",
    "    Extract visit information from exposure dimension records in Butler registry.\n",
    "    \n",
    "    This queries the 'exposure' dimension which contains detailed information about\n",
    "    each exposure including pointing, timing, observation metadata, and exposure parameters.\n",
    "    \n",
    "    Parameters\n",
    "    ----------\n",
    "    registry : Butler registry\n",
    "        The Butler registry to query\n",
    "    where_clause : str\n",
    "        SQL-like WHERE clause for filtering exposures\n",
    "    limit : int, optional\n",
    "        Maximum number of records to return (None for all)\n",
    "    \n",
    "    Returns\n",
    "    -------\n",
    "    df_visits : pandas.DataFrame\n",
    "        DataFrame containing visit information with columns:\n",
    "        - id: exposure ID (visit ID)\n",
    "        - obs_id: observation ID\n",
    "        - day_obs: day of observation (YYYYMMDD format)\n",
    "        - seq_num: sequence number\n",
    "        - ra: right ascension (degrees)\n",
    "        - dec: declination (degrees)\n",
    "        - sky_angle: sky rotation angle (degrees)\n",
    "        - azimuth: azimuth (degrees)\n",
    "        - zenith_angle: zenith angle (degrees)\n",
    "        - airmass: calculated airmass\n",
    "        - filter: physical filter name\n",
    "        - band: single-letter band identifier (u, g, r, i, z, y)\n",
    "        - observation_type: type of observation (science, calibration, etc.)\n",
    "        - science_program: science program identifier\n",
    "        - target_name: target field name\n",
    "        - exposure_time: exposure duration (seconds)\n",
    "        - mjd: midpoint Modified Julian Date\n",
    "    \"\"\"\n",
    "    \n",
    "    rows = []\n",
    "    query = registry.queryDimensionRecords('exposure', where=where_clause)\n",
    "    \n",
    "    for count, info in enumerate(query):\n",
    "        if limit and count >= limit:\n",
    "            break\n",
    "        \n",
    "        try:\n",
    "            # Extract time information\n",
    "            jd_start = info.timespan.begin.value\n",
    "            jd_end = info.timespan.end.value\n",
    "            the_Time_start = Time(jd_start, format='jd', scale='utc')\n",
    "            the_Time_end = Time(jd_end, format='jd', scale='utc')\n",
    "            mjd_start = the_Time_start.mjd\n",
    "            mjd_end = the_Time_end.mjd\n",
    "            mjd_mid = (mjd_start + mjd_end) / 2.0\n",
    "            \n",
    "            # Calculate airmass from zenith angle\n",
    "            zenith_rad = np.radians(info.zenith_angle if info.zenith_angle else 0.0)\n",
    "            airmass = 1.0 / np.cos(zenith_rad) if np.cos(zenith_rad) > 0.01 else 99.0\n",
    "            \n",
    "            # Extract band from filter name\n",
    "            filter_name = info.physical_filter if info.physical_filter else ''\n",
    "            band = filter_name[0].lower() if filter_name else 'unknown'\n",
    "            \n",
    "            # Build row dictionary\n",
    "            row = {\n",
    "                'id': info.id,\n",
    "                'obs_id': info.obs_id,\n",
    "                'day_obs': info.day_obs,\n",
    "                'seq_num': info.seq_num,\n",
    "                'ra': info.tracking_ra if info.tracking_ra else np.nan,\n",
    "                'dec': info.tracking_dec if info.tracking_dec else np.nan,\n",
    "                'sky_angle': info.sky_angle if info.sky_angle else np.nan,\n",
    "                'azimuth': info.azimuth if info.azimuth else np.nan,\n",
    "                'zenith_angle': info.zenith_angle if info.zenith_angle else np.nan,\n",
    "                'airmass': airmass,\n",
    "                'filter': filter_name,\n",
    "                'band': band,\n",
    "                'observation_type': info.observation_type if info.observation_type else '',\n",
    "                'science_program': info.science_program if info.science_program else '',\n",
    "                'target_name': info.target_name if info.target_name else '',\n",
    "                'exposure_time': info.exposure_time if info.exposure_time else np.nan,\n",
    "                'jd': float(jd_start),\n",
    "                'mjd': float(mjd_mid),\n",
    "                'obsStartMJD': float(mjd_start),\n",
    "                'expMidptMJD': float(mjd_mid),\n",
    "            }\n",
    "            rows.append(row)\n",
    "            \n",
    "        except Exception as e:\n",
    "            print(f\"Error at exposure {info.id if info else 'unknown'}: {e}\")\n",
    "            continue\n",
    "    \n",
    "    # Create DataFrame\n",
    "    df_visits = pd.DataFrame(rows)\n",
    "    \n",
    "    # Filter for science observations only\n",
    "    df_science = df_visits[df_visits.observation_type == 'science'].copy()\n",
    "    df_science.reset_index(drop=True, inplace=True)\n",
    "    \n",
    "    print(f\"Extracted {len(df_visits)} total exposures, {len(df_science)} science exposures\")\n",
    "    return df_science"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Extract all science visits from Butler\n",
